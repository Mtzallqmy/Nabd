# Required for Telegram polling. Use numeric IDs separated by commas.
BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Optional read-only token for explicitly authorized repositories.
GITHUB_TOKEN=
# Keep Compose's volume-backed default by leaving this blank there.
DATABASE_URL=
# Optional direct PostgreSQL connection for Alembic.
MIGRATION_DATABASE_URL=
PORT=8080
LOG_LEVEL=INFO
